📁 내 게임 폴더
 ├── index.html
 └── sans.mp3
<!-- BGM 오디오 태그: 내 파일(sans.mp3)로 연결 -->
<audio id="bgm" loop src="sans.mp3"></audio>
// BGM 재생 및 정지 함수
function playSansBGM() {
    const bgm = document.getElementById('bgm');
    if (bgm) {
        bgm.currentTime = 0; // 처음부터 재생
        bgm.play().catch(e => console.log("화면 터치 후 자동 재생됩니다."));
    }
}

function stopSansBGM() {
    const bgm = document.getElementById('bgm');
    if (bgm) {
        bgm.pause();
        bgm.currentTime = 0;
    }
}

// 캐릭터 선택 완료 후 게임 들어갈 때
function confirmCharacterSelection() {
    // ... 기존 코드 ...
    
    if (isBossMode) {
        document.getElementById('p2-label').innerText = "😈 L 보스 (체력: 750)";
        document.getElementById('boss-joystick-panel').classList.remove('hidden');
        playSansBGM(); // 보스전 진입 시 샌즈 노래 재생
    } else {
        stopSansBGM();
        // ...
    }

    startCountdownAndGame();
}

// 로비로 돌아갈 때 BGM 끄기
function showLobby() {
    stopSansBGM();
    // ... 기존 로비 이동 코드 ...
}

// 게임 오버 시 BGM 끄기
function checkGameOver() {
    if (p1.hp <= 0 || p2.hp <= 0) {
        gameStarted = false;
        stopSansBGM(); // 게임이 끝나면 BGM 끄기
        // ... 기존 게임오버 코드 ...
    }
}
