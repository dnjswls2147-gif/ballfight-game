const music = document.getElementById("bossMusic");

music.pause();
music.currentTime = 0;
music.muted = false;
music.volume = 1;

music.play().catch(error => {
  console.log("노래 재생 실패:", error);
  alert("노래 재생에 실패했어. 다시 버튼을 눌러 줘!");
});
let bossStarting = false;

async function startBossCountdown() {
  if (bossStarting) return;
  bossStarting = true;

  const countdown = document.getElementById("countdown");
  const music = document.getElementById("bossMusic");

  countdown.style.display = "flex";

  for (let i = 3; i >= 1; i--) {
    countdown.textContent = i;
    await new Promise(resolve =>
      setTimeout(resolve, 1000)
    );
  }

  countdown.textContent = "BOSS FIGHT!";
  
  try {
    await music.play();
  } catch (error) {
    console.log("음악 재생에 실패했어.", error);
  }

  await new Promise(resolve =>
    setTimeout(resolve, 800)
  );

  countdown.style.display = "none";

  // 여기에 기존 보스전 시작 함수를 연결해 줘.
  if (typeof startBossFight === "function") {
    startBossFight();
  }

  bossStarting = false;
}

